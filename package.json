{
  "name": "ai-system",
  "version": "25.0.0-rc1",
  "description": "Self-hosted AI system with LLMs and image generation",
  "main": "client.py",
  "scripts": {
    "install": "bash install.sh",
    "start": "docker-compose up -d",
    "stop": "docker-compose stop",
    "restart": "docker-compose restart",
    "logs": "docker-compose logs -f",
    "down": "docker-compose down",
    "pull-model": "docker exec -it ollama ollama pull",
    "health": "curl http://localhost:8000/health",
    "stats": "curl http://localhost:8000/stats",
    "test": "python -m pytest -q && node --test tests/voice-engine.test.js tests/ptt.test.js",
    "test:python": "python -m pytest -q",
    "test:voice": "node --test tests/voice-engine.test.js tests/ptt.test.js",
    "verify": "python -m compileall -q api-gateway tests && python -m pytest -q && node --test tests/voice-engine.test.js tests/ptt.test.js",
    "reports": "python tools/generate_repo_reports.py",
    "reports:check": "python tools/generate_repo_reports.py --check"
  },
  "keywords": [
    "ai",
    "llm",
    "ollama",
    "stable-diffusion",
    "self-hosted",
    "local-ai"
  ],
  "author": "Self-Hosted AI System",
  "license": "MIT"
}
