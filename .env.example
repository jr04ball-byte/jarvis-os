# Local Ollama brain (fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
JARVIS_FAST_MODEL=gemma2:9b
JARVIS_DEEP_MODEL=mistral-nemo:12b
JARVIS_TOOL_MODEL=llama3.1:8b

# V21 Multi-Brain routing. Jarvis owns routing/authority; providers are specialists.
JARVIS_PRIMARY_BRAIN=gemini
JARVIS_DEEP_BRAIN=openai
JARVIS_LOCAL_BRAIN=ollama
JARVIS_CODING_BRAIN=opencode
# Legacy V20 fields are safe to leave in existing .env files but are no longer required.
JARVIS_SECONDARY_BRAIN=opencode
JARVIS_FALLBACK_BRAIN=ollama

# OpenAI deep-reasoning specialist (API billing is separate from ChatGPT Plus)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=medium
# Leave false for current reasoning models unless a compatible model needs temperature.
OPENAI_SEND_TEMPERATURE=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_PROVIDER=opencode-go
OPENCODE_MODEL=deepseek-v4-flash
OPENCODE_AGENT=

# Google OAuth (Gmail + Calendar)
# Copy your values from email-agent-saas/.env into a real .env file (which is gitignored).
# This file is just a template — leave values blank, do NOT commit secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Token encryption key (32-byte url-safe base64).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is auto-generated and stored in api_data/.token_key (dev only).
TOKEN_ENCRYPTION_KEY=

# Where tokens are stored (mounted from api_data volume in Docker)
API_DATA_DIR=./data

# Google Gemini API key (for AI assistant fallback or vision tasks)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: identify the Google Cloud project used for Gemini. The API key is associated with this project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Local tool permissions
AI_HOST_FILES=C:\\Users\\YOUR_USER
AI_ALLOWED_PATHS=/host-files
# Optional Home Assistant bridge
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# LAN security
# Required when docker-compose.lan.yml is enabled. Generate a long random value.
AI_API_TOKEN=change-this-to-a-long-random-token

# Windows host bridge for opening files/apps from the native Windows host
AI_HOST_BRIDGE_URL=http://host.docker.internal:8765
AI_HOST_BRIDGE_TOKEN=change-this-to-another-long-random-token
# Host bridge binds to localhost by default. Set 0.0.0.0 only for an explicitly secured LAN/Docker deployment.
AI_HOST_BRIDGE_BIND=127.0.0.1

# Optional separate service integrations
SALES_MACHINE_URL=
EMAIL_AGENT_URL=

# Production browser voice: Deepgram Flux STT + Aura TTS
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=aura-2-asteria-en

# Optional Jarvis-style web research (off by default)
EXA_API_KEY=

# Optional Windows computer control (OFF by default)
AI_COMPUTER_CONTROL=false
AI_COMPUTER_REQUIRE_CONFIRM=true
# Windows computer control: localhost host agent. Set true only on the Windows PC.
AI_COMPUTER_ADMIN=false
AI_COMPUTER_SCREEN_FPS=2
AI_COMPUTER_SCREEN_MAX_WIDTH=1280
AI_COMPUTER_OBSERVER_MODEL=gemma3:4b

# Adaptive compute / VRAM policy
# auto = GPU-first; if NVIDIA is unavailable, CPU fallback; if VRAM is low, protect the active model
# cpu = force CPU/RAM inference (Ollama num_gpu=0)
# hybrid = explicitly offload a configured number of layers to GPU
JARVIS_COMPUTE_MODE=auto
JARVIS_MIN_FREE_VRAM_MB=768
JARVIS_HYBRID_GPU_LAYERS=20
JARVIS_ONE_MODEL_POLICY=true
JARVIS_MAX_HISTORY_MESSAGES=24
JARVIS_CONTEXT_CHARS=14000
JARVIS_RAG_CHARS=6000

# Jarvis Model Lab
LMSTUDIO_URL=http://localhost:1234
JARVIS_MODEL_LAB_ENABLED=true
JARVIS_MODEL_LAB_BENCHMARK_TIMEOUT=75

# Jarvis Autopilot project workspaces (no secrets)
# These default to the standard Windows locations used by the current build.
JARVIS_EMAIL_AGENT_PATH=C:\\Users\\jr04b\\email-agent-saas
JARVIS_AI_WORKFORCE_PATH=C:\\Users\\jr04b\\ai-workforce
JARVIS_OUTBOUND_AI_PATH=C:\\Users\\jr04b\\outbound-ai

# Jarvis V23 — secure Gemini Live browser authentication
# The permanent GEMINI_API_KEY stays server-side. Browsers receive only short-lived ephemeral tokens.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_AUTH_TOKEN_URL=https://generativelanguage.googleapis.com/v1alpha/auth_tokens
GEMINI_LIVE_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained

# Multi-brain provider circuit breaker
JARVIS_CIRCUIT_FAILURES=3
JARVIS_CIRCUIT_COOLDOWN_SECONDS=30
